# Echo Pact 环境变量模板
# 复制这个文件为 .env，填入真实的值，不要把 .env 传到 GitHub！

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI embedding 安全开关（默认关闭真实 API）
# 只有两个开关都为 true 且 OPENAI_API_KEY 非空时，才允许真实调用。
USE_REAL_EMBEDDING=false
ALLOW_REAL_API_CALLS=false
OPENAI_API_KEY=

# 单个进程允许的真实 embedding 请求次数上限
REAL_API_MAX_CALLS=50

# Local read-only MCP gateway. Keep real private paths in local configuration,
# never in committed files. The gateway accepts no credential or API key here.
ECHO_PACT_MCP_DB_PATH=
ECHO_PACT_MCP_AGENT_ID=
# Always-on read-only deployment uses a verified active-snapshot pointer
# instead of opening the writable source database directly.
ECHO_PACT_MCP_SNAPSHOT_POINTER=

# Telegram text-only read-only bot. Keep real values only in an untracked .env
# or another protected local secret store. The life-recall rollout must point
# at a reviewed read-only generation containing exactly ChatGPT and Codex
# source channels; their raw records and provenance remain distinct.
ECHO_TELEGRAM_DB_PATH=
ECHO_TELEGRAM_AGENT_ID=
ECHO_TELEGRAM_BOT_TOKEN=
ECHO_TELEGRAM_ALLOWED_USER_ID=
ECHO_TELEGRAM_BAD_CASE_DIR=
ECHO_TELEGRAM_LOCAL_API_PORT=8765
ECHO_TELEGRAM_SPEECH_POLICY=

# Optional OpenAI-compatible answer layer. If absent or unavailable, the bot
# returns the recalled A/B evidence with an explicit "嘴被捂住了" fallback.
ECHO_LLM_API_KEY=
ECHO_LLM_MODEL=
ECHO_LLM_BASE_URL=
ECHO_LLM_THINKING_MODE=
ECHO_LLM_MAX_TOKENS=600

# 数据库路径（默认在项目根目录）
DB_PATH=./echo_pact.db

# FastAPI 服务端口
PORT=8000

# 旧 ACCESS_CODE 兼容门禁（可选；新身份凭证由本地 admin_cli 签发）
# 留空表示不启用旧码。没有旧码且没有任何已签发凭证时，V1 接口返回 503。
# 请生成足够长的随机串，例如：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ACCESS_CODE=

# 设为 1 可强制关闭旧 ACCESS_CODE，只接受 cred_id.secret 身份凭证。
ECHO_DISABLE_LEGACY_CODE=0
