# Echo Pact 环境变量模板
# 复制这个文件为 .env，填入真实的值，不要把 .env 传到 GitHub！

# ===== 真实 API 总闸（y_patch_2026-05-30）=====
# 默认全关。两个都显式写 true 才会发生真实调用，缺一不可。
USE_REAL_EMBEDDING=false
ALLOW_REAL_API_CALLS=false
# 熔断阈值：单次进程真实 embedding 请求超过该次数直接中断
REAL_API_MAX_CALLS=50

# OpenAI（向量 embedding 用，上线开真实调用时必填）
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek（预留：当前后端代码未使用，前端/外部接入可用）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 数据库路径（默认在项目根目录）
DB_PATH=./echo_pact.db

# Chroma 向量库路径（生产服务器为 /opt/echo-pact/chroma_db，本地可用 ./chroma_db）
CHROMA_PATH=./chroma_db

# FastAPI 服务端口
PORT=8000

# 访问密码（可选）
ACCESS_CODE=your_access_code_here
